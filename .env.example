# =============================================================================
# 2026 FIFA World Cup dashboard — secrets & config.  Copy to .env, then fill in.
#   cp .env.example .env
# NEVER commit .env.  Every value below is read at runtime; nothing is hardcoded.
# The app still BOOTS with zero keys — each unconfigured/unavailable source just
# renders a visible "data unavailable" state instead of inventing numbers.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) FOOTBALL DATA  (fixtures, live scores, results, lineups)  — REQUIRED for
#    fixtures + the win-probability model (the model is built from real results).
# -----------------------------------------------------------------------------
# Default provider: football-data.org (free tier).
#   Get a free key: https://www.football-data.org/client/register
#   Free tier includes the FIFA World Cup competition (code "WC") but is rate
#   limited (~10 requests/min) and does NOT expose a precise live match minute
#   or detailed lineups — see README "Data source limitations".
FOOTBALL_DATA_API_KEY=

# Optional override (defaults shown). Only change if the provider moves.
# FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# FOOTBALL_WC_COMPETITION=WC

# -----------------------------------------------------------------------------
# 2) SPORTSBOOK ODDS  (market implied probability)  — REQUIRED for the Model vs
#    Market comparison + value flags.
# -----------------------------------------------------------------------------
#   Get a free key: https://the-odds-api.com/  (free tier ~500 requests/month)
#   Sport key used: soccer_fifa_world_cup
THE_ODDS_API_KEY=
# Optional (defaults shown):
# THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# ODDS_REGIONS=us,uk,eu
# ODDS_SPORT_KEY=soccer_fifa_world_cup

# -----------------------------------------------------------------------------
# 3) POLYMARKET  (prediction-market odds + public trader leaderboard/positions)
#    NO API KEY REQUIRED — all endpoints used are public/read-only.
# -----------------------------------------------------------------------------
# Optional base-URL overrides (defaults shown). Leave blank to use defaults.
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_DATA_URL=https://data-api.polymarket.com
# POLYMARKET_LEADERBOARD_URL=https://lb-api.polymarket.com
# Comma-separated text used to find World Cup markets on Polymarket:
# POLYMARKET_WC_QUERY=world cup,fifa

# -----------------------------------------------------------------------------
# Runtime / model tuning (all optional — sensible defaults in backend/config.py)
# -----------------------------------------------------------------------------
# DB_PATH=data/worldcup.db
# REFRESH_LIVE_SECONDS=60          # poll cadence while any match is in play
# REFRESH_BASELINE_SECONDS=21600   # full refresh cadence otherwise (6h)
# VALUE_EDGE_THRESHOLD=0.05        # min model-vs-market edge to flag as "value"
# ELO_K_FACTOR=40                  # World-Football-Elo K (importance of WC matches)
# CORS_ORIGINS=http://localhost:5173
